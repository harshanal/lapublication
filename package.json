{
  "name": "lalibrary",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --webpack -H 127.0.0.1 -p 3012",
    "build": "tsx scripts/build-catalogue.ts && next build",
    "start": "next start -H 127.0.0.1 -p 3012",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "manage": "tsx scripts/manage.ts",
    "sync:drive": "tsx scripts/sync-drive.ts",
    "sync:apply": "tsx scripts/sync-drive.ts --apply",
    "catalogue:build": "tsx scripts/build-catalogue.ts",
    "images:optimize": "tsx scripts/optimize-images.ts",
    "thumbnails:queue": "tsx scripts/thumbnail-queue.ts"
  },
  "dependencies": {
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.20.0",
    "typescript": "^5",
    "vitest": "^3.2.0"
  }
}
